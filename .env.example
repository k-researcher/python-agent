AGENT_HOST=127.0.0.1
AGENT_PORT=8080
AGENT_DATABASE_URL=sqlite+aiosqlite:///./data/agent.db
AGENT_EXECUTION_MODE=embedded
AGENT_REDIS_URL=redis://127.0.0.1:6379/0
AGENT_REDIS_NAMESPACE=python-agent
AGENT_WORKER_NAME=
AGENT_WORKER_LOCK_TTL_SECONDS=3600
AGENT_WORKER_VISIBILITY_TIMEOUT_SECONDS=300

# Используются Docker Compose; runtime напрямую их не читает.
AGENT_POSTGRES_PASSWORD=
AGENT_REDIS_PASSWORD=
AGENT_PROJECTS_ROOT=./workspace
AGENT_BIND_ADDRESS=127.0.0.1
AGENT_UID=10001
AGENT_GID=10001

# Модели и провайдеры описываются в config/models.yaml (шаблон config/models.example.yaml).
# Переменные ниже — прежняя схема, используется, если config/models.yaml отсутствует.
AGENT_LLM_BASE_URL=https://api.openai.com/v1
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=gpt-4o-mini
AGENT_LLM_TIMEOUT_SECONDS=120
AGENT_LLM_MAX_RETRIES=2
AGENT_LLM_MAX_TOKENS=8192
AGENT_DEFAULT_LLM_PROFILE=default
# Опционально заменяет одиночные AGENT_LLM_* несколькими именованными профилями.
# AGENT_LLM_PROFILES={"fast":{"base_url":"https://provider.example/v1","api_key":"...","model":"fast-model"},"reasoning":{"base_url":"https://provider.example/v1","api_key":"...","model":"reasoning-model","max_tokens":16000}}
AGENT_CONTEXT_WINDOW=128000
AGENT_CONTEXT_RESERVED_TOKENS=12000
AGENT_MAX_INFERENCE_STEPS=100
AGENT_MAX_TOOL_RESULT_CHARS=30000

AGENT_RAW_LLM_LOG=false
AGENT_KNOWLEDGE_BASE_ENABLED=false
AGENT_ALLOW_NETWORK_TOOLS=false
AGENT_NETWORK_ALLOWLIST=[]
AGENT_HTTP_MAX_RESPONSE_BYTES=1000000
AGENT_WEB_SEARCH_URL_TEMPLATE=
AGENT_DATABASE_CONNECTIONS={}
AGENT_SSH_CONNECTIONS={}

AGENT_KNOWLEDGE_BASE_EMBEDDING_URL=
AGENT_KNOWLEDGE_BASE_EMBEDDING_API_KEY=
AGENT_KNOWLEDGE_BASE_EMBEDDING_MODEL=

AGENT_MAX_PARALLEL_SESSIONS=4
AGENT_MAX_CHILD_DEPTH=3
AGENT_MAX_CHILD_WAIT_SECONDS=600

# Вход в UI: одноразовая ссылка из консоли (или `agent auth link`) -> cookie-сессия.
# Для удалённого доступа укажите HTTPS-адрес UI и его hostname в списке разрешённых хостов.
AGENT_PUBLIC_ORIGIN=
AGENT_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
# Дополнительные origins, например Vite dev-сервер: ["http://localhost:5173"]
AGENT_EXTRA_ORIGINS=[]
# IP reverse proxy, которому разрешено передавать X-Forwarded-For/Proto.
AGENT_TRUSTED_PROXY_IPS=[]
AGENT_AUTH_LINK_TTL_SECONDS=600
AGENT_AUTH_SESSION_TTL_SECONDS=2592000
AGENT_AUTH_OPEN_BROWSER=true

# Мастер-ключ шифрования API-ключей, сохранённых через UI (обязателен в redis-режиме).
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENT_SECRET_KEY=

# Необязательно: токен для CLI, скриптов и healthcheck (заголовок X-Agent-Token).
AGENT_API_TOKEN=
